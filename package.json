{
  "name": "lista-de-tarefas",
  "version": "0.0.0-desenvolvimento",
  "private": true,
  "description": "Lista de Tarefas simples (HTML + JavaScript) usada como projeto do PGCS com enfoque DevOps (CI/CD).",
  "license": "MIT",
  "scripts": {
    "lint": "eslint .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "start": "npx --yes http-server src -p 8080 -c-1"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/tarefas.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "branches": 80,
        "functions": 80,
        "statements": 80
      }
    }
  },
  "engines": {
    "node": ">=20.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "semantic-release": "^24.2.9"
  }
}
